---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="branko/everythink">
  <section class="section">
    <div class="container below-nav-container w-container"></div>
  </section>
  <section class="section hero-section top-border bottom-border">
    <div class="container w-container">
      <div class="w-layout-grid main-heading-grid">
        <div class="hero-text">
          <h1 class="main-heading">
            <span>B2B SEO &amp; AI Search marketing agency</span>
            <span class="heading-span-1 logo-home"></span>
            based in Europe
            <span class="heading-span-2"></span>
            Organic growth partners
            <span class="heading-span-3"></span>
            of innovative SaaS &amp; Fintech startups &amp; enterprise
            companies.
          </h1>
        </div>
        <div class="hero-empty-block"></div>
      </div>
    </div>
  </section>
  <section class="section hero-section">
    <div class="container w-container">
      <div class="w-layout-grid hero-grid light-theme without-grid">
        <div class="hero-content-wrapper tablet-border-bottom-none">
          <p class="content-paragraph">
            We create <strong class="strong-bold">SEO content</strong> at the
            intersection of science and creativity, focused on unlocking
            healthy growth at <strong class="strong-bold">efficient
            economics.</strong>
          </p>
        </div>
        <div class="hero-empty-wrapper"></div>
        <div class="hero-empty-wrapper"></div>
      </div>
    </div>
  </section>
</BaseLayout>
