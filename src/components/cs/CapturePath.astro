---
// Lead capture path: record first, verify twice. Four steps in a row, two
// independent checks underneath that both end in the same alert.
import Figure from './Figure.astro';

interface Step { title: string; text: string }
interface Props {
  title: string;
  sub: string;
  caption: string;
  steps: Step[]; // exactly 4
  reconcile: Step;
  alert: Step;
  labels: { logged: string; notFound: string; gap: string };
}
const { title, sub, caption, steps, reconcile, alert, labels } = Astro.props;
---
<Figure title={title} sub={sub} caption={caption}>
  <div class="cp">
    <ol class="cp__steps">
      {steps.map((s, i) => (
        <li class="cp__box" style={`--i:${i}`}>
          <span class="cp__n mono">{String(i + 1).padStart(2, '0')}</span>
          <p class="cp__title">{s.title}</p>
          <p class="cp__text">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="cp__links" aria-hidden="true">
      <span class="cp__drop cp__drop--logged"><span class="mono">{labels.logged}</span></span>
      <span class="cp__drop cp__drop--missing"><span class="mono">{labels.notFound}</span></span>
    </div>

    <div class="cp__checks">
      <div class="cp__box cp__box--wide">
        <p class="cp__title">{reconcile.title}</p>
        <p class="cp__text">{reconcile.text}</p>
      </div>
      <span class="cp__gap mono" aria-hidden="true">{labels.gap}</span>
      <div class="cp__box cp__box--alert">
        <p class="cp__title">{alert.title}</p>
        <p class="cp__text">{alert.text}</p>
      </div>
    </div>
  </div>
</Figure>

<style>
  .cp__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .cp__box { position: relative; border: 1px solid #c9ced6; background: #fff; padding: 12px 14px 13px; }
  .cp__steps .cp__box + .cp__box::before {
    content: ''; position: absolute; left: -22px; top: 50%; width: 22px; border-top: 1px solid var(--ink);
  }
  .cp__steps .cp__box + .cp__box::after {
    content: ''; position: absolute; left: -5px; top: calc(50% - 4px); border: 4px solid transparent; border-left: 5px solid var(--ink); border-right: 0;
  }
  .cp__n { font-size: 11.5px; color: var(--text-soft); }
  .cp__title { margin: 4px 0 0; font-size: 14.5px; line-height: 20px; font-weight: 600; color: var(--ink); }
  .cp__text { margin: 2px 0 0; font-size: 13.5px; line-height: 19px; color: var(--text-soft); }

  .cp__links { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 22px; height: 54px; }
  .cp__drop { position: relative; display: flex; align-items: center; }
  .cp__drop::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px solid var(--ink); }
  .cp__drop::after { content: ''; position: absolute; left: calc(50% - 4px); bottom: -1px; border: 4px solid transparent; border-top: 5px solid var(--ink); border-bottom: 0; }
  .cp__drop span { position: relative; margin-left: calc(50% + 10px); font-size: 12px; line-height: 16px; color: var(--text-soft); }
  .cp__drop span { white-space: nowrap; }
  .cp__drop--logged { grid-column: 2; }
  .cp__drop--missing { justify-content: flex-end; }
  .cp__drop--missing span { margin: 0 calc(50% + 10px) 0 0; }
  .cp__drop--missing { grid-column: 4; }

  .cp__checks { display: grid; grid-template-columns: minmax(0, 2fr) 70px minmax(0, 2fr); align-items: center; }
  .cp__box--wide { grid-column: 1; }
  .cp__gap { position: relative; text-align: center; font-size: 12px; color: var(--text-soft); padding-bottom: 14px; }
  .cp__gap::after { content: ''; position: absolute; left: 4px; right: 4px; bottom: 6px; border-top: 1px solid var(--ink); }
  .cp__gap::before { content: ''; position: absolute; right: 2px; bottom: 2px; border: 4px solid transparent; border-left: 5px solid var(--ink); border-right: 0; }
  .cp__box--alert { background: var(--hl-bg); border: 1.5px solid var(--ink); }
  .cp__box--alert .cp__text { color: var(--hl-ink); }

  @media (max-width: 899px) {
    .cp__steps { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .cp__steps .cp__box + .cp__box::before { left: 24px; top: -18px; width: 0; height: 18px; border-top: 0; border-left: 1px solid var(--ink); }
    .cp__steps .cp__box + .cp__box::after { left: 20px; top: -6px; border: 4px solid transparent; border-top: 5px solid var(--ink); border-bottom: 0; }
    .cp__links { grid-template-columns: minmax(0, 1fr); height: auto; padding: 14px 0; }
    .cp__drop { grid-column: 1 !important; height: 26px; }
    .cp__drop::before, .cp__drop::after { left: 24px; }
    .cp__drop::after { left: 20px; }
    .cp__drop span { margin-left: 40px; }
    .cp__drop--missing { display: none; }
    .cp__checks { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .cp__gap { text-align: left; padding: 10px 0 10px 40px; }
    .cp__gap::after { left: 24px; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 1px solid var(--ink); }
    .cp__gap::before { left: 20px; right: auto; bottom: -1px; border: 4px solid transparent; border-top: 5px solid var(--ink); border-bottom: 0; }
  }
</style>
