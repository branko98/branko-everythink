---
// Big number + what it means, framed on the grid. Used for a chapter's headline finding.
interface Props { value: string; text: string; note?: string }
const { value, text, note } = Astro.props;
---
<div class="callout" data-reveal data-counters>
  <span class="callout__sq callout__sq--tl" aria-hidden="true"></span>
  <span class="callout__sq callout__sq--br" aria-hidden="true"></span>
  <p class="callout__value" data-count={value}>{value}</p>
  <div>
    <p class="callout__text">{text}</p>
    {note && <p class="callout__note mono">{note}</p>}
  </div>
</div>

<style>
  .callout {
    position: relative;
    margin: 26px 0 8px;
    padding: 26px 28px;
    border: 1px dashed var(--line);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }
  .callout__sq { position: absolute; width: 8px; height: 8px; background: var(--ink); }
  .callout__sq--tl { left: -4px; top: -4px; }
  .callout__sq--br { right: -4px; bottom: -4px; }
  .callout__value { margin: 0; font-size: 64px; line-height: 1; font-weight: 500; letter-spacing: -0.05em; color: var(--ink-strong); font-variant-numeric: tabular-nums; }
  .callout__text { margin: 0; font-size: 21px; line-height: 29px; font-weight: 550; letter-spacing: -0.02em; color: var(--ink-strong); }
  .callout__note { margin: 8px 0 0; font-size: 12.5px; line-height: 18px; color: var(--text-soft); }
  @media (max-width: 767px) {
    .callout { grid-template-columns: minmax(0, 1fr); gap: 10px; padding: 22px 18px; }
    .callout__value { font-size: 52px; }
    .callout__text { font-size: 18px; line-height: 26px; }
  }
</style>
