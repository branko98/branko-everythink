<section class="section-graph">
  <div class="container-rail">
    <div class="hero-slider-wrapper">
      <div class="hero-slider">
        <div class="hero-slider-content-wrapper">
          <div class="category-badge">
            <div class="text-block-5">B2B SaaS</div>
          </div>

          <div class="div-block-12">
            <div class="div-block-678">
              <div class="div-block-679">
                <div class="header-case-study">
                  <span class="blue-highlight">0</span>
                </div>
              </div>
              <div class="code-embed-57" aria-hidden="true">
                <svg
                  viewBox="0 0 12 5"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M8.64844 0C9.16797 0.566406 9.61719 0.998047 9.99609 1.29492C10.375 1.58789 10.7324 1.80664 11.0684 1.95117V2.21484C10.6816 2.40234 10.3066 2.64258 9.94336 2.93555C9.58008 3.22461 9.14648 3.65039 8.64258 4.21289H8.19141C8.55859 3.42773 8.94336 2.82422 9.3457 2.40234H0V1.81055H9.3457C9.04883 1.43164 8.8418 1.15039 8.72461 0.966797C8.60742 0.783203 8.43359 0.460938 8.20312 0H8.64844Z"
                    fill="currentColor"
                  ></path>
                </svg>
              </div>
              <div class="header-case-study">
                <span class="blue-highlight">+227.9%</span>
              </div>
            </div>
            <div class="header-case-study">organic signups<br /></div>
            <div class="header-case-study">in 6 months.</div>
          </div>

          <div class="case-study-wrapper">
            <div class="case-study-image" aria-hidden="true">M</div>
            <div class="div-block-13">
              <div class="case-study-name">Myos</div>
              <div class="case-study-category">Backed startup</div>
            </div>
          </div>
        </div>

        <a href="#" class="blue-link-wrapper reset-style">
          <div class="blue-link">Case study</div>
          <div class="arrow-wrapper-new ml-0">
            <div class="w-layout-hflex line blue"></div>
            <div class="arrow-right blue"></div>
          </div>
        </a>

        <div class="hero-slider-image-wrapper">
          <div class="code-embed-6">
            <img
              src="/graph-line.svg"
              alt="Graphic representation of growth"
              class="image-8 graph-line"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="picture-overlay"></div>
        </div>
      </div>
    </div>
  </div>
</section>
