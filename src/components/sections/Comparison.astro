---
const rows = [
  {
    good: "B2B SaaS, seed to Series B. Spending at least a few thousand a month on paid, with a CRM you already use and a sales team that takes the calls.",
    bad: "You've been told the problem is the campaigns. It usually isn't. You already suspect that.",
  },
  {
    good: "You have a website that converts on its best day, and a demo flow you can measure end to end — even if today only pieces of it are actually tracked.",
    bad: "You keep swapping agencies every six months looking for a new hook. The pipeline math doesn't change.",
  },
];
---

<section
  id="works-when"
  class="max-w-[1200px] mx-auto px-6 py-24 md:py-32 border-t border-[color:var(--color-rule)]"
>
  <h2
    class="max-w-3xl text-3xl md:text-5xl font-medium leading-[1.1] text-[color:var(--color-ink)]"
  >
    This works when you're already spending, and it isn't working.
  </h2>

  <div class="mt-12 md:mt-16 border border-[color:var(--color-rule)]">
    <div
      class="grid grid-cols-1 md:grid-cols-2 border-b border-[color:var(--color-rule)] bg-[color:var(--color-canvas)]"
    >
      <div class="p-4 md:p-5 border-b md:border-b-0 md:border-r border-[color:var(--color-rule)]">
        <span class="mono-label">Good example</span>
      </div>
      <div class="p-4 md:p-5">
        <span class="mono-label">Bad example</span>
      </div>
    </div>

    {
      rows.map((r, i) => (
        <div
          class={`grid grid-cols-1 md:grid-cols-2 ${
            i < rows.length - 1
              ? "border-b border-[color:var(--color-rule)]"
              : ""
          }`}
        >
          <div class="p-6 md:p-7 border-b md:border-b-0 md:border-r border-[color:var(--color-rule)] text-[15px] leading-relaxed">
            <span class="font-semibold underline decoration-[color:var(--color-accent)] decoration-2 underline-offset-4">
              {r.good.split(".")[0]}.
            </span>
            <span class="text-[color:var(--color-muted)]">
              {" "}
              {r.good.split(".").slice(1).join(".").trim()}
            </span>
          </div>
          <div class="p-6 md:p-7 text-[15px] leading-relaxed">
            <span class="font-semibold underline decoration-[color:var(--color-accent)] decoration-2 underline-offset-4">
              You've been told the problem is the campaigns.
            </span>
            <span class="text-[color:var(--color-muted)]">
              {" "}
              {r.bad.replace("You've been told the problem is the campaigns.", "").trim()}
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>
