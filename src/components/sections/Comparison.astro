---
const rows = [
  {
    good: {
      lead: "B2B SaaS, seed to Series B.",
      rest: "Spending at least a few thousand a month on paid, with a CRM you already use and a sales team that takes the calls.",
    },
    bad: {
      lead: "You've been told the problem is the campaigns.",
      rest: "It usually isn't. You already suspect that.",
    },
  },
  {
    good: {
      lead: "A website that converts on its best day.",
      rest: "And a demo flow you can measure end to end — even if today only pieces of it are actually tracked.",
    },
    bad: {
      lead: "You keep swapping agencies every six months.",
      rest: "Looking for a new hook. The pipeline math doesn't change.",
    },
  },
];
---

<section
  id="works-when"
  class="border-b border-dashed border-[color:var(--color-rule)]"
>
  <div class="container-rail px-5 md:px-10 py-16 md:py-20">
    <h2 class="max-w-[720px]">
      This works when you're already spending, and it isn't working.
    </h2>

    <div class="mt-10 md:mt-12 border border-[color:var(--color-card)] rounded-xl overflow-hidden">
      <div
        class="grid grid-cols-1 md:grid-cols-2 border-b border-dashed border-[color:var(--color-rule)] bg-[color:var(--color-canvas)]"
      >
        <div class="p-4 md:p-5 border-b md:border-b-0 md:border-r border-dashed border-[color:var(--color-rule)]">
          <span class="mono-label">Good example</span>
        </div>
        <div class="p-4 md:p-5">
          <span class="mono-label">Bad example</span>
        </div>
      </div>

      {
        rows.map((r, i) => (
          <div
            class={`grid grid-cols-1 md:grid-cols-2 ${
              i < rows.length - 1
                ? "border-b border-dashed border-[color:var(--color-rule)]"
                : ""
            }`}
          >
            <div class="p-5 md:p-6 border-b md:border-b-0 md:border-r border-dashed border-[color:var(--color-rule)] text-[14px] leading-[1.65]">
              <span class="font-semibold text-[color:var(--color-ink)]">
                {r.good.lead}
              </span>{" "}
              <span class="text-[color:var(--color-muted)]">{r.good.rest}</span>
            </div>
            <div class="p-5 md:p-6 text-[14px] leading-[1.65]">
              <span class="font-semibold text-[color:var(--color-ink)]">
                {r.bad.lead}
              </span>{" "}
              <span class="text-[color:var(--color-muted)]">{r.bad.rest}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
