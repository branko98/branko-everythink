---
const metrics = [
  { value: "8.4M+", label: "Attributed organic signups in 2024" },
  { value: "80K+", label: "Pages created in 2024" },
  { value: "+426.7%", label: "Average YoY organic traffic increase" },
  { value: "00", label: "Vanity metrics" },
];
---

<section id="hero" class="border-b border-dashed border-[color:var(--color-rule)]">
  <div class="container-rail px-5 md:px-10 pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="grid md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-8">
        <h1 class="max-w-[720px]">
          B2B SaaS companies don't have an ads problem. They have a leak
          between the ad, the site, the CRM and sales, and{" "}
          <span class="font-bold">nobody owns the whole chain.</span>
        </h1>
        <p class="mt-6 max-w-xl text-[15px] text-[color:var(--color-muted)] leading-relaxed">
          Seven years building growth for B2B SaaS — the channels, the tracking,
          the CRM, and the systems that connect them.
        </p>
      </div>

      <aside
        class="md:col-span-4 border border-[color:var(--color-card)] rounded-xl bg-[color:var(--color-canvas)] p-5"
      >
        <div class="mono-label mb-3">Case study</div>
        <div class="flex items-baseline gap-2">
          <span
            class="font-mono text-[26px] tracking-tight text-[color:var(--color-ink)]"
          >
            +227.9%
          </span>
          <span class="text-[13px] text-[color:var(--color-muted)]">
            in signups
          </span>
        </div>
        <div class="mt-1 text-[12px] text-[color:var(--color-muted)]">
          Myos — attributed organic signups, 6 months
        </div>
        <svg
          viewBox="0 0 320 80"
          class="mt-4 w-full h-20 text-[color:var(--color-ink)]"
          aria-hidden="true"
        >
          <polyline
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            points="0,72 30,66 60,62 90,56 120,50 150,44 180,36 210,30 240,22 270,16 300,12 320,8"
          ></polyline>
          <line
            x1="0"
            y1="76"
            x2="320"
            y2="76"
            stroke="currentColor"
            stroke-opacity="0.15"
            stroke-width="1"
          ></line>
        </svg>
        <a
          href="#"
          class="mt-3 inline-flex items-center gap-1 text-[13px] font-medium text-[color:var(--color-accent)] hover:opacity-70"
        >
          Case study
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </div>

  <div
    class="border-t border-dashed border-[color:var(--color-rule)]"
  >
    <div class="container-rail">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {
          metrics.map((m, i) => (
            <div
              class={`px-5 md:px-6 py-6 md:py-7 ${
                i < metrics.length - 1
                  ? "border-b md:border-b-0 md:border-r border-dashed border-[color:var(--color-rule)]"
                  : ""
              } ${i === 1 ? "border-b md:border-b-0" : ""}`}
            >
              <div class="font-mono text-[22px] md:text-[24px] tracking-tight text-[color:var(--color-ink)] leading-none">
                {m.value}
              </div>
              <div class="mt-2 mono-label leading-snug">{m.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
