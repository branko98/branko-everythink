---
const metrics = [
  { value: "8.4M+", label: "Attributed organic signups in 2024" },
  { value: "80K+", label: "Pages created in 2024" },
  { value: "+426.7%", label: "Average YoY organic traffic increase" },
  { value: "00", label: "Vanity metrics" },
];
---

<section id="hero" class="max-w-[1200px] mx-auto px-6 pt-20 pb-24 md:pt-28 md:pb-32">
  <div class="grid md:grid-cols-12 gap-10 items-start">
    <div class="md:col-span-7">
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-[72px] font-medium leading-[1.05] text-[color:var(--color-ink)]"
      >
        B2B SaaS companies don't have an ads problem. They have a leak between
        the ad, the site, the CRM and sales, and{" "}
        <span class="font-semibold">nobody owns the whole chain.</span>
      </h1>
      <p class="mt-8 max-w-xl text-base md:text-lg text-[color:var(--color-muted)] leading-relaxed">
        Seven years building growth for B2B SaaS — the channels, the tracking,
        the CRM, and the systems that connect them.
      </p>
    </div>

    <aside
      class="md:col-span-5 md:mt-4 border border-[color:var(--color-rule)] rounded-md bg-[color:var(--color-canvas)] p-5"
    >
      <div class="mono-label mb-4">Case study</div>
      <div class="flex items-baseline gap-3">
        <span
          class="font-mono text-3xl md:text-4xl tracking-tight text-[color:var(--color-ink)]"
        >
          +227.9%
        </span>
        <span class="text-sm text-[color:var(--color-muted)]">in signups</span>
      </div>
      <div class="mt-1 text-xs text-[color:var(--color-muted)]">
        Myos — attributed organic signups, 6 months
      </div>
      <svg
        viewBox="0 0 320 90"
        class="mt-5 w-full h-24 text-[color:var(--color-ink)]"
        aria-hidden="true"
      >
        <polyline
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          points="0,80 30,74 60,70 90,66 120,58 150,52 180,42 210,36 240,28 270,20 300,14 320,10"
        ></polyline>
        <line
          x1="0"
          y1="88"
          x2="320"
          y2="88"
          stroke="currentColor"
          stroke-opacity="0.15"
          stroke-width="1"
        ></line>
      </svg>
      <a
        href="#"
        class="mt-4 inline-block text-sm underline decoration-[color:var(--color-accent)] decoration-2 underline-offset-4 hover:opacity-70"
      >
        Case study →
      </a>
    </aside>
  </div>

  <div
    class="mt-20 md:mt-28 grid grid-cols-2 md:grid-cols-4 border-t border-[color:var(--color-rule)]"
  >
    {
      metrics.map((m) => (
        <div class="py-6 md:py-8 pr-6 border-b md:border-b-0 md:border-r border-[color:var(--color-rule)] last:border-r-0">
          <div class="font-mono text-2xl md:text-3xl tracking-tight text-[color:var(--color-ink)]">
            {m.value}
          </div>
          <div class="mt-2 mono-label leading-tight">{m.label}</div>
        </div>
      ))
    }
  </div>
</section>
