---
interface Meta {
  label: string;
  value: string;
}

interface Props {
  company: string;
  quote: string;
  authorName: string;
  authorRole: string;
  authorInitials?: string;
  meta?: Meta[];
}

const { company, quote, authorName, authorRole, authorInitials, meta } =
  Astro.props;
const initials =
  authorInitials ??
  authorName
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("");
---

<article
  class="max-w-[1200px] mx-auto px-6 py-16 md:py-24 border-t border-[color:var(--color-rule)]"
>
  <div class="grid md:grid-cols-12 gap-8">
    <div class="md:col-span-3">
      <div class="text-lg md:text-xl font-medium text-[color:var(--color-ink)]">
        {company}
      </div>
    </div>

    <div class="md:col-span-9">
      <blockquote
        class="text-lg md:text-xl leading-relaxed text-[color:var(--color-ink)]"
      >
        {
          quote.split(/(\*\*[^*]+\*\*)/).map((chunk) =>
            chunk.startsWith("**") && chunk.endsWith("**") ? (
              <span
                class="font-semibold underline decoration-[color:var(--color-accent)] decoration-2 underline-offset-4"
              >
                {chunk.slice(2, -2)}
              </span>
            ) : (
              <span>{chunk}</span>
            )
          )
        }
      </blockquote>

      <div class="mt-8 flex items-center gap-4">
        <div
          class="w-10 h-10 rounded-full bg-[color:var(--color-canvas)] border border-[color:var(--color-rule)] flex items-center justify-center text-xs font-medium text-[color:var(--color-muted)]"
        >
          {initials}
        </div>
        <div class="text-sm">
          <div class="font-medium text-[color:var(--color-ink)]">
            {authorName}
          </div>
          <div class="text-[color:var(--color-muted)]">{authorRole}</div>
        </div>
      </div>
    </div>
  </div>

  {
    meta && meta.length > 0 && (
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 border-t border-[color:var(--color-rule)]">
        {meta.map((m) => (
          <div class="py-5 pr-6 border-r border-[color:var(--color-rule)] last:border-r-0">
            <div class="mono-label">{m.label}</div>
            <div class="mt-2 text-sm text-[color:var(--color-ink)]">
              {m.value}
            </div>
          </div>
        ))}
      </div>
    )
  }
</article>
