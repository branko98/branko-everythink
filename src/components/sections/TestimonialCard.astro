---
interface Meta {
  label: string;
  value: string;
}

interface Props {
  company: string;
  quote: string;
  authorName: string;
  authorRole: string;
  authorInitials?: string;
  meta?: Meta[];
}

const { company, quote, authorName, authorRole, authorInitials, meta } =
  Astro.props;
const initials =
  authorInitials ??
  authorName
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("");
---

<article class="border-b border-dashed border-[color:var(--color-rule)]">
  <div class="container-rail px-5 md:px-10 py-14 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 md:gap-10">
      <div class="md:col-span-3">
        <div class="text-[15px] font-semibold text-[color:var(--color-ink)]">
          {company}
        </div>
      </div>

      <div class="md:col-span-9">
        <blockquote
          class="text-[15px] md:text-[16px] leading-[1.65] text-[color:var(--color-ink)]"
        >
          {
            quote.split(/(\*\*[^*]+\*\*)/).map((chunk) =>
              chunk.startsWith("**") && chunk.endsWith("**") ? (
                <span
                  class="font-semibold underline decoration-[color:var(--color-highlight)] decoration-2 underline-offset-[3px]"
                >
                  {chunk.slice(2, -2)}
                </span>
              ) : (
                <span>{chunk}</span>
              )
            )
          }
        </blockquote>

        <div class="mt-6 flex items-center gap-3">
          <div
            class="w-8 h-8 rounded-full bg-[color:var(--color-canvas)] border border-[color:var(--color-card)] flex items-center justify-center text-[10px] font-semibold text-[color:var(--color-muted)]"
          >
            {initials}
          </div>
          <div class="text-[13px]">
            <div class="font-semibold text-[color:var(--color-ink)]">
              {authorName}
            </div>
            <div class="text-[color:var(--color-muted)] text-[12px]">
              {authorRole}
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      meta && meta.length > 0 && (
        <div class="mt-10 pt-6 grid grid-cols-2 md:grid-cols-4 gap-4 border-t border-dashed border-[color:var(--color-rule)]">
          {meta.map((m) => (
            <div class="pr-4">
              <div class="mono-label">{m.label}</div>
              <div class="mt-1.5 text-[13px] text-[color:var(--color-ink)]">
                {m.value}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</article>
