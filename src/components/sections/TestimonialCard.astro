---
interface Meta {
  label: string;
  value: string;
}

interface Props {
  company: string;
  quote: string;
  authorName: string;
  authorRole: string;
  authorInitials?: string;
  meta?: Meta[];
}

const { company, quote, authorName, authorRole, authorInitials, meta } =
  Astro.props;
const initials =
  authorInitials ??
  authorName
    .split(" ")
    .map((w) => w[0])
    .slice(0, 2)
    .join("");
---

<article class="max-w-[1200px] mx-auto px-6 py-12 md:py-16">
  <div
    class="border border-[color:var(--color-rule)] rounded-md bg-[color:var(--color-paper)] p-6 md:p-10"
  >
    <div class="grid md:grid-cols-12 gap-6 md:gap-8">
      <div class="md:col-span-3">
        <div
          class="text-base md:text-lg font-medium text-[color:var(--color-ink)]"
        >
          {company}
        </div>
      </div>

      <div class="md:col-span-9">
        <blockquote
          class="text-base md:text-lg leading-relaxed text-[color:var(--color-ink)]"
        >
        {
          quote.split(/(\*\*[^*]+\*\*)/).map((chunk) =>
            chunk.startsWith("**") && chunk.endsWith("**") ? (
              <span
                class="font-semibold underline decoration-[color:var(--color-accent)] decoration-2 underline-offset-4"
              >
                {chunk.slice(2, -2)}
              </span>
            ) : (
              <span>{chunk}</span>
            )
          )
        }
        </blockquote>

        <div class="mt-6 md:mt-8 flex items-center gap-3">
          <div
            class="w-9 h-9 rounded-full bg-[color:var(--color-canvas)] border border-[color:var(--color-rule)] flex items-center justify-center text-[11px] font-medium text-[color:var(--color-muted)]"
          >
            {initials}
          </div>
          <div class="text-sm">
            <div class="font-medium text-[color:var(--color-ink)]">
              {authorName}
            </div>
            <div class="text-[color:var(--color-muted)] text-xs md:text-sm">
              {authorRole}
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      meta && meta.length > 0 && (
        <div class="mt-8 md:mt-10 pt-6 md:pt-8 grid grid-cols-2 md:grid-cols-4 gap-4 border-t border-[color:var(--color-rule)]">
          {meta.map((m) => (
            <div class="pr-4">
              <div class="mono-label">{m.label}</div>
              <div class="mt-1.5 text-sm text-[color:var(--color-ink)]">
                {m.value}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</article>
