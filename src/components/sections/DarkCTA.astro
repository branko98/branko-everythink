---
const brands = [
  "YCombinator",
  "Reuters",
  "Bloomberg",
  "MidWatchmey",
  "Speedwork",
  "Entrepreneur First",
];
---

<section class="border-b border-dashed border-[color:var(--color-rule)]">
  <div class="container-rail px-5 md:px-10 py-14 md:py-16">
    <div
      class="rounded-xl bg-[color:var(--color-ink)] text-[color:var(--color-ink-invert)] p-8 md:p-12"
    >
      <div class="flex items-center gap-2 opacity-70">
        <span
          class="inline-block w-2 h-2 rounded-full border border-[color:var(--color-ink-invert)]"
        ></span>
        <span
          class="mono-label !text-[color:var(--color-ink-invert)] !opacity-70"
        >
          everythink
        </span>
      </div>

      <h2
        class="mt-8 max-w-[720px] !text-[color:var(--color-ink-invert)]"
      >
        AI-native SEO Agency, maximizing the growth probability on ∞ Perplexity.
      </h2>

      <p class="mt-5 max-w-2xl text-[14px] md:text-[15px] opacity-80 leading-[1.65]">
        everythink is a B2B SEO & GEO agency, partnering exclusively with SaaS,
        Fintech & AI companies. The result? Compounding growth made through
        organic positioning: everywhere people search for information,
        including both Google and LLM-based engines.
      </p>

      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a
          href="mailto:branko.j.98@gmail.com"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-md bg-[color:var(--color-ink-invert)] text-[color:var(--color-ink)] text-[13px] font-semibold hover:opacity-90 transition-opacity"
        >
          Contact our team
        </a>
        <a
          href="#"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-md border border-[color:var(--color-ink-invert)]/25 text-[13px] font-semibold hover:bg-[color:var(--color-ink-invert)]/10 transition-colors"
        >
          Schedule a meeting
        </a>
      </div>

      <div class="mt-10 pt-6 border-t border-[color:var(--color-ink-invert)]/10">
        <div class="mono-label !text-[color:var(--color-ink-invert)] !opacity-60 mb-3">
          As seen in / trusted by
        </div>
        <div
          class="flex flex-wrap gap-x-7 gap-y-2 text-[13px] font-medium opacity-70"
        >
          {brands.map((b) => <span>{b}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
