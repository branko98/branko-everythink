---
// Shared growth chart: faint vertical grid, one black line, pulsing end dot,
// month labels underneath in mono. Draws itself when scrolled into view
// (see .chart rules in motion.css + animations.ts).
interface Props {
  data: number[]; // y-values 0–100, evenly spaced on x
  labels?: string[]; // first sits left, last sits right, the rest spread evenly
  label: string; // accessible description
  height?: number;
  mobileHeight?: number;
}
const { data, labels = [], label, height = 192, mobileHeight = 150 } = Astro.props;

const W = 632;
const H = 192;
const n = data.length;
const pts = data
  .map((v, i) => `${((i / (n - 1)) * W).toFixed(1)},${(H - 3 - (v / 100) * (H - 8)).toFixed(1)}`)
  .join(' ');
const dotTop = H - 3 - (data[n - 1] / 100) * (H - 8);
const gridCount = 23;
const grid = Array.from({ length: gridCount }, (_, i) => (i / (gridCount - 1)) * (W - 1) + 0.5);
---
<div class="plot" style={`--h:${height}px;--hm:${mobileHeight}px`}>
  <div class="chart" role="img" aria-label={label}>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" fill="none" aria-hidden="true">
      <g class="chart-grid" stroke="#e8e8eb" stroke-width="1">
        {grid.map((x, i) => <line x1={x} y1="0" x2={x} y2={H - 2} style={`--i:${i}`} vector-effect="non-scaling-stroke" />)}
      </g>
      <line x1="0" y1={H - 1.5} x2={W} y2={H - 1.5} stroke="#d0d5dd" stroke-width="1" vector-effect="non-scaling-stroke" />
      <polyline class="chart-line" points={pts} stroke="#141413" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
    <span class="chart-dot-wrap" style={`top:${(dotTop / H) * 100}%`}>
      <span class="chart-dot-pulse"></span>
      <span class="chart-dot"></span>
    </span>
  </div>
  {labels.length > 0 && (
    <ul class="chart-labels mono" aria-hidden="true">
      {labels.map((l) => <li>{l}</li>)}
    </ul>
  )}
</div>

<style>
  .chart { position: relative; height: var(--h); }
  .chart svg { width: 100%; height: 100%; }
  .chart-dot-wrap { position: absolute; right: -3px; width: 7px; height: 7px; margin-top: -3.5px; }
  .chart-dot, .chart-dot-pulse { position: absolute; inset: 0; border-radius: 50%; background: #141413; }
  .chart-dot-pulse { opacity: 0; }
  .chart-labels { list-style: none; margin: 8px 0 0; padding: 0; display: flex; justify-content: space-between; font-size: 13.5px; line-height: 20px; color: var(--ink); }
  .chart-labels li:first-child { transform: translateX(-4px); }
  .chart-labels li:last-child { transform: translateX(4px); }

  @media (max-width: 767px) {
    .chart { height: var(--hm); }
    .chart-labels { font-size: 12.5px; }
  }
</style>
