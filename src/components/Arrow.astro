---
interface Props { dir?: 'right' | 'left' | 'out'; color?: string }
const { dir = 'right', color = 'currentColor' } = Astro.props;
---
{dir === 'out' ? (
  <svg class="arrow arrow--out" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
    <path d="M4 1.5H1.5v7h7V6M6 1.5h2.5V4M8.5 1.5L4.5 5.5" stroke={color} stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
) : (
  <svg class="arrow" width="7" height="10" viewBox="0 0 7 10" fill="none" aria-hidden="true">
    <path d={dir === 'right' ? 'M1.5 1.5L5 5L1.5 8.5' : 'M5.5 1.5L2 5L5.5 8.5'} stroke={color} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
