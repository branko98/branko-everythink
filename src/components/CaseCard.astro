---
import Arrow from './Arrow.astro';
import LineChart from './LineChart.astro';
import { caseCard as c } from '../data/home';
---
<section class="row row--line case">
  <div class="wrap">
    <article class="case__card">
      <div class="case__info" data-reveal>
        <span class="case__tag mono">{c.tag}</span>
        <p class="case__stat"><mark class="hl case__hl">{c.highlight}</mark>{c.text}</p>
        <div class="case__client">
          <img class="case__logo" src={c.logo} alt="" width="96" height="96" decoding="async" />
          <div>
            <div class="case__name">{c.client}</div>
            <div class="case__cat">{c.clientCategory}</div>
          </div>
        </div>
        <a href={c.href} class="case__link">{c.linkLabel} <Arrow /></a>
      </div>

      <div class="case__plot">
        <LineChart
          data={c.chart}
          labels={c.chartLabels}
          label={`Growth chart, ${c.chartLabels[0]} to ${c.chartLabels[c.chartLabels.length - 1]}: ${c.highlight}${c.text}`}
        />
      </div>
    </article>
  </div>
</section>

<style>
  .case .wrap { height: auto; }
  .case__card {
    position: relative;
    display: grid;
    grid-template-columns: 350px minmax(0, 1fr);
    min-height: 244px;
    padding: 34px 42px 28px 0;
    margin-bottom: 22px;
  }
  .case__info { padding-left: 36px; display: flex; flex-direction: column; align-items: flex-start; }
  .case__tag { font-size: 12px; padding: 3px 8px; border-radius: 4px; background: #f0f0f2; color: var(--text-soft); }
  .case__stat { margin-top: 18px; max-width: 300px; font-size: 22px; line-height: 30px; font-weight: 560; letter-spacing: -0.01em; }
  .case__hl { font-weight: 560; color: var(--ink); }
  .case__client { margin-top: 28px; display: flex; align-items: center; gap: 12px; }
  .case__logo { width: 32px; height: 32px; border-radius: 7px; display: block; flex: none; }
  .case__name { font-size: 17px; line-height: 22px; font-weight: 500; letter-spacing: -0.01em; }
  .case__cat { margin-top: 1px; font-size: 13.5px; color: #7b7c84; }
  .case__link { margin-top: 26px; display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; }
  .case__link:hover .arrow { transform: translateX(2px); }
  .case__link .arrow { transition: transform .2s var(--ease); }

  .case__plot { align-self: start; margin-top: 13px; }

  @media (max-width: 900px) {
    .case__card { grid-template-columns: 270px minmax(0, 1fr); padding-right: 28px; }
  }
  @media (max-width: 767px) {
    .case__card { grid-template-columns: minmax(0, 1fr); padding: 26px 20px 8px 0; row-gap: 26px; }
    .case__info { padding-left: 14px; }
    .case__stat { max-width: 280px; font-size: 20px; line-height: 28px; }
    .case__plot { margin: 0 0 0 14px; }
    }
</style>
