---
import Arrow from './Arrow.astro';
import { site } from '../data/home';
---
<!-- Sticky bar: always visible at the top while scrolling -->
<header class="header" data-header>
  <div class="wrap header__bar">
    <a href="/" class="logo" aria-label="Branko / Everythink – home">
      <img src="/logo.png" alt="branko / everythink" width="904" height="150" />
    </a>
    <a href={site.ctaHref} class="pill header__cta">{site.ctaLabel} <Arrow /></a>
  </div>
</header>
<!-- keeps the original empty band under the logo (design spacing + grid lines) -->
<div class="row row--line header-space" aria-hidden="true"><div class="wrap"></div></div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 76px;
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
    transition: background-color .25s ease;
  }
  .header.is-stuck { background: rgba(255, 255, 255, 0.94); }
  .header__bar { display: flex; align-items: flex-start; justify-content: space-between; padding-top: 18px; }
  .header-space { height: 83px; }

  .logo { display: block; width: 296px; }
  .logo img { width: 100%; height: auto; }
  .header__cta { height: 40px; border: 1px solid #dcdce0; color: var(--ink); background: #fff; }
  .header__cta:hover { color: var(--ink); border-color: #b9b9c0; }

  @media (max-width: 767px) {
    .header { height: 64px; }
    .header__bar { align-items: center; padding: 0 12px 0 14px; }
    .logo { width: 176px; }
    .header-space { height: 32px; }
  }
  @media (max-width: 400px) {
    .logo { width: 150px; }
    .header__cta { padding: 0 12px 0 14px; font-size: 13.5px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
