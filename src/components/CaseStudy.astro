---
// 02-case-study — slider sa karticom (industrija, rezultat, klijent, link),
// grafikon (SVG, ne raster), strelice levo/desno.
// Vrednosti iz reference/02-case-study/styles.json + summary.md.
// design.png određuje raspored i sadržaj; grafikon je SVG (linija + vertikalne
// linije + završna tačka), skalira se sa karticom.
//
// Placeholder slajdovi. Chart data = niz 0..1 vrednosti (y normalizovano).

interface Slide {
  industry: string;
  result: { highlight: string; rest: string };
  client: { initials: string; color: string; name: string; caption: string };
  link: string;
  chart: number[]; // 0..1 y values, evenly spaced left → right
}

const slides: Slide[] = [
  {
    industry: "Fintech",
    result: { highlight: "+227.9%", rest: " in signups in 6 months." },
    client: { initials: "M", color: "#7B93FF", name: "Myos", caption: "Revenue-based financing" },
    link: "#",
    chart: [
      0.06, 0.07, 0.08, 0.10, 0.12, 0.14, 0.17, 0.20, 0.24, 0.29,
      0.34, 0.40, 0.46, 0.52, 0.58, 0.64, 0.70, 0.75, 0.80, 0.84,
      0.87, 0.90, 0.92,
    ],
  },
  {
    industry: "AI / LLM SaaS",
    result: { highlight: "0→2.7M", rest: " organic visitors in 13 months." },
    client: { initials: "Si", color: "#E64B24", name: "Speedinvest", caption: "Backed startup" },
    link: "#",
    chart: [
      0.03, 0.04, 0.05, 0.06, 0.06, 0.10, 0.08, 0.12, 0.14, 0.13,
      0.22, 0.30, 0.34, 0.31, 0.42, 0.45, 0.55, 0.60, 0.70, 0.76,
      0.82, 0.86, 0.92,
    ],
  },
];

// Konstante grafika (viewBox koordinate)
const CHART_W = 689;
const CHART_H = 220;

function buildPath(data: number[]): string {
  const n = data.length;
  const step = CHART_W / (n - 1);
  // Bottom = CHART_H (invertujemo y jer 0 = dno)
  const pts = data.map((v, i) => [i * step, CHART_H - v * CHART_H]);
  // Blaga smooth linija: Catmull-Rom → Bezier
  const d: string[] = [`M ${pts[0][0].toFixed(2)} ${pts[0][1].toFixed(2)}`];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d.push(`C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`);
  }
  return d.join(" ");
}

function endPoint(data: number[]): [number, number] {
  const n = data.length;
  const x = CHART_W;
  const y = CHART_H - data[n - 1] * CHART_H;
  return [x, y];
}

// 23 vertikalne pozadinske linije (izmereno iz design.png)
const GRID_LINES = 23;
const gridXs = Array.from({ length: GRID_LINES }, (_, i) => (i * CHART_W) / (GRID_LINES - 1));
---

<section class="case-study">
  <div class="container">
    <div class="case-slider" data-slider>
      <div class="case-slider__viewport">
        <div class="case-slider__track" data-track>
          {slides.map((s) => (
            <article class="case-slide">
              <div class="case-slide__content">
                <span class="case-slide__badge">{s.industry}</span>

                <h3 class="case-slide__result">
                  <span class="case-slide__result-hl">{s.result.highlight}</span>{s.result.rest}
                </h3>

                <div class="case-slide__client">
                  <div class="case-slide__client-logo" style={`background:${s.client.color}`}>
                    {s.client.initials}
                  </div>
                  <div class="case-slide__client-text">
                    <div class="case-slide__client-name">{s.client.name}</div>
                    <div class="case-slide__client-caption">{s.client.caption}</div>
                  </div>
                </div>

                <a href={s.link} class="case-slide__link">
                  Case study
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M1 5h7M5.5 2.5 8 5 5.5 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>

              <div class="case-slide__chart">
                <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="none" aria-hidden="true">
                  <g class="chart-grid">
                    {gridXs.map((x) => (
                      <line x1={x} y1={0} x2={x} y2={CHART_H} />
                    ))}
                  </g>
                  <path class="chart-line" d={buildPath(s.chart)} vector-effect="non-scaling-stroke" />
                  <circle class="chart-end" cx={endPoint(s.chart)[0]} cy={endPoint(s.chart)[1]} r="4" />
                </svg>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .case-study {
    padding: 0 var(--header-padding-x);
  }
  /* Ispod 991 .container preuzima safe-area margin (20 px); sekcija ne treba svoj. */
  @media (max-width: 991px) {
    .case-study { padding: 0; }
  }

  /* Kartica */
  .case-slider {
    position: relative;
    border: 1px solid var(--color-card-border);
    border-radius: var(--card-radius);
    background: var(--color-bg);
  }

  .case-slider__viewport {
    overflow: hidden;
    border-radius: var(--card-radius);
  }
  .case-slider__track {
    display: flex;
    transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .case-slide {
    flex: 0 0 100%;
    min-width: 0;
    height: var(--card-height);
    padding: var(--card-padding);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    box-sizing: border-box;
  }

  /* Leva kolona */
  .case-slide__content {
    width: 250px; /* .hero-slider-content-wrapper 249.625 */
    height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .case-slide__badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 5px;
    background: var(--color-chip-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
  }

  .case-slide__result {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 22px;
    line-height: 28px;
    letter-spacing: -0.2px;
    color: var(--color-dark);
  }
  .case-slide__result-hl {
    background: var(--color-chip-bg);
    padding: 0 2px;
    border-radius: 2px;
  }

  .case-slide__client {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .case-slide__client-logo {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .case-slide__client-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    line-height: 20px;
    color: var(--color-dark);
  }
  .case-slide__client-caption {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted);
  }

  .case-slide__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-link-blue);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    line-height: 18px;
  }

  /* Grafikon */
  .case-slide__chart {
    flex: 1 1 auto;
    height: 220px;
    min-width: 0;
    border-top: 1px solid var(--color-card-border);
    border-bottom: 1px solid var(--color-card-border);
  }
  .case-slide__chart svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible; /* da završna tačka na desnoj ivici ne bude presečena */
  }
  .chart-grid line {
    stroke: var(--color-card-border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .chart-line {
    fill: none;
    stroke: var(--color-dark);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chart-end {
    fill: var(--color-dark);
  }

  /* ≤ 479 — po originalu: tekst iznad grafika (column layout),
     card postaje viša, padding kartice pada (kroz --card-padding token),
     grafikon niži i puna širina. Media query na kraju bloka da bi imao veću
     specifičnost od baznih pravila iznad (ista specifičnost, kasniji redosled). */
  @media (max-width: 479px) {
    .case-slide {
      flex-direction: column;
      align-items: stretch;
      height: auto;
      gap: 20px;
    }
    .case-slide__content {
      width: 100%;
      height: auto;
      gap: 12px;
    }
    .case-slide__chart {
      height: 156px;
      width: 100%;
      flex: 0 0 156px; /* poništi flex: 1 1 auto iz baznog pravila */
    }
  }
</style>
