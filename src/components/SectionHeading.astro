---
// 05-section-heading — veliki dvobojan naslov levo, prazan aside desno
// sa dashed border-left. Poslednja reč je "everythink" u fontu logoa
// (inline SVG iz /everythink-only.svg; tačka na kraju je tekst).
//
// Layout: 2-col 742/370 na desktopu; 1-col ispod 991 (aside sklopljen), po originalu.
// Tipografija: --text-h2-* iz tokens.css.
---

<section class="container section-heading top-border bottom-border">
  <div class="section-heading__grid">
    <div class="section-heading__main">
      <h2 class="section-heading__h">
        <span class="section-heading__muted">Every agency owns one of these. The money is lost between them. </span><span class="section-heading__dark">That&rsquo;s the whole idea behind <img class="section-heading__word" src="/everythink-only.svg" alt="everythink" width="1151" height="233" />.</span>
      </h2>
    </div>
    <div class="section-heading__aside" aria-hidden="true"></div>
  </div>
</section>

<style>
  /* Padding je na ćeliji sa naslovom (ne na sekciji) da bi grid ćelije
     bile visine cele sekcije. Aside ćelija se stretch-uje na tu visinu,
     pa njen dashed border-left ide od gornje do donje ivice sekcije
     (isti pristup kao u Hero heading bloku). */
  .section-heading {
    padding-top: 0;
    padding-bottom: 0;
  }

  .section-heading__grid {
    display: grid;
    grid-template-columns: 742px 1fr;
    align-items: stretch;
  }

  .section-heading__main {
    min-width: 0;
    padding-top: var(--below-nav-padding-y);
    padding-bottom: var(--below-nav-padding-y);
  }
  .section-heading__aside {
    border-left: var(--container-border);
  }

  .section-heading__h {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    letter-spacing: var(--text-h2-tracking);
    font-weight: var(--text-h2-weight);
    color: var(--color-dark);
  }
  .section-heading__muted { color: var(--color-heading-muted); }
  .section-heading__dark  { color: var(--color-dark); }

  /* SVG reči "everythink" — inline, skalira se sa naslovom (visina u em).
     Bazna visina 0.9em pomnožena sa --heading-wordmark-scale da bi wordmark
     bio malo veći od okolnih slova. ViewBox 1151×233; fill="#000000". */
  .section-heading__word {
    display: inline-block;
    height: calc(0.9em * var(--heading-wordmark-scale));
    width: auto;
    vertical-align: baseline;
    transform: translateY(0.12em);
    margin: 0 0.05em;
  }

  /* ≤ 991 — grid → 1 kolona (po originalu); aside se sklapa. */
  @media (max-width: 991px) {
    .section-heading__grid {
      grid-template-columns: 1fr;
    }
    .section-heading__aside {
      display: none;
    }
  }
</style>
