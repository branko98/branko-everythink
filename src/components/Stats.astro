---
import { stats } from '../data/home';
---
<section class="row row--line stats" aria-label="Results">
  <div class="wrap">
    <ul class="stats__grid" data-counters>
      {stats.map((s, i) => (
        <li class="stat" data-reveal style={`--d:${i * 90}ms`}>
          <span class="stat__bar" aria-hidden="true"></span>
          <span class="stat__value" data-count={s.value}>{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); min-height: 138px; }
  .stat { position: relative; padding: 33px 28px 26px; display: flex; flex-direction: column; border-right: 1px dashed var(--line); }
  .stat:last-child { border-right: 0; }
  .stat__bar { position: absolute; left: -1px; top: 41px; width: 2px; height: 24px; background: var(--ink); }
  .stat__value { font-size: 34px; line-height: 40px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .stat__label { margin-top: 20px; max-width: 200px; font-size: 14.5px; line-height: 21px; color: var(--text-soft); }

  @media (max-width: 767px) {
    .stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat { padding: 26px 16px 24px; }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(-n + 2) { border-bottom: 1px dashed var(--line); }
    .stat__bar { top: 32px; }
    .stat__value { font-size: 28px; line-height: 34px; }
    .stat__label { margin-top: 14px; }
  }
</style>
