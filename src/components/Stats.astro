---
import { getEntry } from 'astro:content';
import { caseCard } from '../data/home';
import { rich } from '../utils/rich';

// the same headline numbers as the case study shown above
const cs = await getEntry('case-studies', caseCard.caseStudy);
const stats = cs?.data.results ?? [];
---
<section class="row row--line stats" aria-label="Results">
  <div class="wrap">
    <ul class="stats__grid" data-counters>
      {stats.map((s, i) => (
        <li class="stat" data-reveal style={`--d:${i * 90}ms`}>
          <span class="stat__bar" aria-hidden="true"></span>
          {s.sentence ? (
            <span class="stat__sentence" set:html={rich(s.sentence)} />
          ) : (
            <>
              <span class="stat__value" data-count={s.value}>{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); min-height: 138px; }
  .stat { position: relative; padding: 33px 28px 26px; display: flex; flex-direction: column; border-right: 1px dashed var(--line); }
  .stat:last-child { border-right: 0; }
  .stat__bar { position: absolute; left: -1px; top: 41px; width: 2px; height: 24px; background: var(--ink); }
  .stat__value { font-size: 32px; line-height: 40px; font-weight: 600; letter-spacing: -0.03em; color: var(--ink-strong); font-variant-numeric: tabular-nums; }
  .stat__sentence { padding-top: 0; font-size: 16px; line-height: 24px; color: var(--text); }
  .stat__sentence :global(strong) { font-weight: 600; color: var(--ink-strong); }
  .stat__label { margin-top: 0; padding-top: 5px; max-width: 200px; font-size: 14.5px; line-height: 21px; color: var(--text-soft); }

  @media (max-width: 767px) {
    .stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat { padding: 26px 16px 24px; }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(-n + 2) { border-bottom: 1px dashed var(--line); }
    .stat__bar { top: 32px; }
    .stat__value { font-size: 23px; line-height: 30px; white-space: nowrap; }
    .stat__label { margin-top: 0; }
    .stat__sentence { font-size: 15px; line-height: 23px; }
  }
</style>
