---
import { hero } from '../data/home';
---
<section class="row row--line hero">
  <div class="wrap">
    <h1 class="display hero__title" data-type="1700">{hero.muted}<span class="strong">{hero.strong}</span></h1>
  </div>
</section>

<section class="row hero-sub">
  <div class="wrap wrap--line">
    <p class="hero-sub__text" data-reveal style="--d: 200ms">{hero.sub}</p>
    <span class="hero-sub__div" aria-hidden="true"></span>
  </div>
</section>

<style>
  .hero__title {
    max-width: 823px;
    min-height: 141px;
    border-right: 1px dashed var(--line);
    padding-right: 8px;
    letter-spacing: -0.04em;
    font-size: clamp(30px, 2.2vw + 8px, 39px);
    line-height: 1.2;
  }
  .hero-sub .wrap { position: relative; min-height: 100px; }
  .hero-sub__text { max-width: 500px; padding: 14px 0 26px; font-size: 17px; line-height: 27px; color: #1c1d22; }
  .hero-sub__div { position: absolute; left: 548px; top: 0; height: 100%; border-left: 1px dashed var(--line); }

  @media (max-width: 1100px) {
    .hero__title { max-width: 80%; }
  }
  @media (max-width: 767px) {
    .hero__title { max-width: none; border-right: 0; padding: 22px 14px 22px; min-height: 0; }
    .hero-sub .wrap { min-height: 0; }
    .hero-sub__text { padding: 18px 14px 24px; }
    .hero-sub__div { display: none; }
  }
</style>
