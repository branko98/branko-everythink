---
// Headline row, then the supporting text in the middle columns of the grid.
import { fit } from '../data/home';
import { rich } from '../utils/rich';
---
<section class="row row--line fit-head">
  <div class="wrap fit-head__grid">
    <h2 class="fit__title" data-type="1300">{fit.title.map((t, i) => <>{i > 0 && ' '}<span class:list={[t.muted && 'muted']}>{t.text}</span></>)}</h2>
    <span class="fit-head__side" aria-hidden="true"></span>
  </div>
</section>

<section class="row row--line fit">
  <div class="wrap fit__grid">
    <span class="fit__side" aria-hidden="true"></span>
    <div class="fit__body">
      {fit.paragraphs.map((p, i) => (
        <p data-reveal style={`--d:${i * 120}ms`} set:html={rich(p)} />
      ))}
    </div>
    <span class="fit__side fit__side--right" aria-hidden="true"></span>
  </div>
</section>

<style>
  /* headline row: title over 4/5 of the column, empty fifth on the right */
  .fit-head__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 1fr); }
  .fit__title {
    padding: 8px 40px 50px 0;
    border-right: 1px dashed var(--line);
    font-size: clamp(29px, 2.2vw + 10px, 40px); /* same size as the Idea headline */
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: #121320;
  }
  .fit__title .muted { color: var(--muted-head); }

  /* text row: empty fifth | text over three fifths | empty fifth */
  .fit__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr) minmax(0, 1fr); }
  .fit__side { border-right: 1px dashed var(--line); }
  .fit__side--right { border-right: 0; border-left: 1px dashed var(--line); }
  .fit__body { padding: 46px 40px 50px; display: flex; flex-direction: column; gap: 24px; }
  .fit__body p { margin: 0; font-size: 17px; line-height: 30px; color: #1a1b20; }
  .fit__body :global(strong) { font-weight: 650; color: var(--ink-strong); }

  @media (max-width: 899px) {
    .fit__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 5fr); }
    .fit__side--right { display: none; }
    .fit__body { padding: 40px 28px 44px; }
  }
  @media (max-width: 767px) {
    .fit-head__grid { grid-template-columns: minmax(0, 1fr); }
    .fit-head__side { display: none; }
    .fit__title { padding: 20px 14px 26px; border-right: 0; }
    .fit__grid { grid-template-columns: minmax(0, 1fr); }
    .fit__side { display: none; }
    .fit__body { padding: 30px 16px 40px; gap: 18px; }
    .fit__body p { font-size: 16px; line-height: 27px; }
  }
</style>
